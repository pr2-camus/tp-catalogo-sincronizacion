application {
  config {
    baseName catalogo
    applicationType microservice
    packageName ar.edu.um.prog2.camus.catalogo
    authenticationType jwt
    buildTool maven
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    cacheProvider no
    enableHibernateCache false
    serviceDiscoveryType no
    serverPort 8081
    skipClient true
  }
}
